# Plantbase — környezeti változók (másold .env-be: `cp .env.example .env`)
# A .env SOHA nem kerül a repóba (lásd .gitignore, konvenciok.md/security.md).

# --- Adatbázis (két kapcsolat, két jog — architektura.md 2. pont) ---
# READ-WRITE: Prisma ezzel viszi a sémát, migrációt, seedet.
# Host port 5433 (lásd docker-compose.yml — a 5432-t egy másik projekt foglalja).
DATABASE_URL="postgresql://plantbase:plantbase@localhost:5433/plantbase?schema=public"
# READ-ONLY: az agent runSql-je ezen fut, csak SELECT (NFR1).
DATABASE_URL_READONLY="postgresql://plantbase_ro:plantbase_ro@localhost:5433/plantbase?schema=public"

# --- Anthropic (a termék-agent, 2. fázistól) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Aktuális, stabil Claude modell; költségérzékeny demóhoz pl. claude-haiku-4-5.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- OpenAI (kizárólag embedding — text-embedding-3-small, 1536 dim) ---
OPENAI_API_KEY="sk-..."
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Ár (USD) 1M input-tokenre — a rag-builder embedding-költség-becsléséhez (listaár változhat).
OPENAI_EMBEDDING_PRICE_PER_M="0.02"

# --- RAG pipeline ---
# Az agent-loop (katalógus-agent) felső korlátja (végtelen ciklus ellen).
MAX_AGENT_ITERATIONS="6"
# DEBUG=true esetén a CLI a stderr-re engine-trace-t ír (stage-enként); SP3b/SP4-ben a frontend is ezt kapja.
DEBUG="false"
# Modellkiosztás: olcsó Haiku a router/HyDE/rerank stage-ekhez, Sonnet az answerhez.
RAG_ROUTER_MODEL="claude-haiku-4-5"
RAG_HYDE_MODEL="claude-haiku-4-5"
RAG_RERANK_MODEL="claude-haiku-4-5"
RAG_ANSWER_MODEL="claude-sonnet-4-6"
# Retrieval: hány chunkot ad vissza a vektorkeresés (topK), és a rerank hányat tart meg (topN).
RAG_TOP_K="12"
RAG_RERANK_TOP_N="5"
# Grounding-küszöb: e cosine-similarity ALATT "nincs találat → nem válaszolok" (2026-07-28-i kalibráció: releváns ~0.53–0.69).
RAG_GROUNDING_THRESHOLD="0.35"

# --- Backend (SP3b) — a POST /api/chat + debug endpointok portja ---
PORT=3000
